# Leave SUPABASE_* empty to run on the built-in in-memory store (zero config demo).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # service_role key. SERVER-SIDE ONLY, never ship to the extension/frontend

# Optional hardening
API_KEY=                       # if set, every /api request must send X-API-Key
RATE_LIMIT_PER_MIN=60
MAX_UPLOAD_MB=5
HASH_SALT=change-me-to-a-random-string

# Download redirect tracing: auto (real, falls back to simulated if offline) | real | mock
TRACE_MODE=auto
# If OCR/QR binaries are missing: 1 = return a clearly-flagged SIMULATED result (demo), 0 = HTTP 503
MEDIA_SIMULATION=1

# Optional local LLM (Ollama): `ollama pull llama3.2`. The API works fine without it.
LLM_MODE=auto                  # auto | off
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT=25

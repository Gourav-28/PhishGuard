{
  "manifest_version": 3,
  "name": "PhishGuard AI",
  "version": "2.1.0",
  "description": "Real-time AI phishing, scam, malicious-URL and download protection for Gmail and the web.",
  "minimum_chrome_version": "102",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "tabs", "identity", "alarms", "notifications", "webNavigation", "downloads", "contextMenus"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://www.googleapis.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "oauth2": {
    "client_id": "1031001681970-kje5d0vmri6q1fcpuilj5v3rdmi6q4u2.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "action": {
    "default_title": "PhishGuard AI",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
